{
  "name": "cubesat-telemetry-mission-control",
  "version": "1.0.0",
  "description": "CubeSat 1U Telemetry System - React Mission Control Dashboard & Ground Station Bridge",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "sim": "node server.js --sim",
    "build": "npm --prefix frontend install && npm --prefix frontend run build",
    "dev:frontend": "npm --prefix frontend run dev",
    "forward": "node telemetry-forwarder.js"
  },
  "keywords": [
    "cubesat",
    "telemetry",
    "esp32",
    "mission-control",
    "open-mct",
    "react",
    "threejs",
    "chartjs"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.19.2",
    "serialport": "^12.0.0",
    "ws": "^8.17.0"
  }
}
